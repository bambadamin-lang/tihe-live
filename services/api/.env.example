# ─── TIHE Live API ───
# Copy to .env and fill in. Generate the cryptographic values with:
#   ./infra/scripts/generate-secrets.sh

NODE_ENV=development
PORT=3000
API_PREFIX=v1
LOG_LEVEL=debug

# ─── Database ───
DATABASE_URL=postgresql://tihe:tihe_dev_password@localhost:5432/tihe?schema=public

# ─── Redis (BullMQ + rate limiting) ───
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatible: MinIO in dev, any provider in prod) ───
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tihe_minio
S3_SECRET_KEY=tihe_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RAW=tihe-raw
S3_BUCKET_VOD=tihe-vod
# Presigned URLs are signed for the host the client will use. If clients reach MinIO through
# nginx, this must be the public hostname, not the internal one, or every signature fails.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGN_TTL_SECONDS=120

# ─── Crypto (from generate-secrets.sh — NEVER commit real values) ───
KEK_BASE64=
LICENSE_PRIVATE_KEY_BASE64=
LICENSE_PUBLIC_KEY_BASE64=
JWT_SECRET=
OTP_PEPPER=

# ─── Tokens ───
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── OTP ───
# Console driver prints codes to the API log. Switch to kavenegar in production.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_MAX_ATTEMPTS=5

# ─── Protection defaults (courses can override) ───
DEFAULT_MAX_DEVICES=2
DEFAULT_MAX_CONCURRENT_STREAMS=1
DEFAULT_OFFLINE_WINDOW_DAYS=30
PLAYBACK_SESSION_TTL_SECONDS=7200
PLAYBACK_HEARTBEAT_SECONDS=30

# ─── LiveKit webhook verification ───
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_production_00000000
# Set true ONLY in development: accepts unsigned webhooks so fake-egress.sh works.
LIVEKIT_WEBHOOK_ALLOW_UNSIGNED=true

# ─── Media pipeline ───
RAW_RETENTION_DAYS=7
