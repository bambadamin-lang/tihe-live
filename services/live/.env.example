# ─── TIHE Live — services/live (live classroom) ───
# Copy to .env. Unset LIVE_DATABASE_URL / REDIS_URL / S3_ENDPOINT to run fully in memory.

NODE_ENV=development
PORT=3100

# Own database on the shared Postgres server (ADR-0012)
LIVE_DATABASE_URL=postgresql://tihe:tihe_dev_password@localhost:5432/tihe_live?schema=public
REDIS_URL=redis://localhost:6379

# Shared with services/api, which signs the access tokens this service verifies.
JWT_SECRET=
# Only this service: signs 2-minute gateway tickets. `openssl rand -base64 48`
LIVE_TICKET_SECRET=

# LiveKit (infra/docker/livekit.yaml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_production_00000000
# Development only: lets webhooks be posted by hand.
LIVEKIT_WEBHOOK_ALLOW_UNSIGNED=true

# What clients are told to connect to, and what Egress's Chrome (inside Docker) reaches.
PUBLIC_GATEWAY_URL=ws://localhost:3100/v1/live/ws
EGRESS_TEMPLATE_URL=http://host.docker.internal:3100/v1/live/egress-template/index.html
EGRESS_GATEWAY_URL=ws://host.docker.internal:3100/v1/live/ws

# metadata.json goes next to each recording in the raw bucket (docs/06)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tihe_minio
S3_SECRET_KEY=tihe_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RAW=tihe-raw

# stub: users and courses from dev/directory.json. http: services/api internal endpoints.
DIRECTORY_MODE=stub
DIRECTORY_STUB_FILE=dev/directory.json
API_INTERNAL_URL=http://localhost:3000
API_INTERNAL_TOKEN=

IOS_SECURE_LAYER=true
