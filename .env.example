# ─── TIHE Live ───
# Copy to .env at the repo root and fill in. Generate the cryptographic values with:
#   ./infra/scripts/generate-secrets.sh
#
# One file for the whole workspace: the API, the media worker and the Prisma CLI all read it.

NODE_ENV=development
PORT=3000
API_PREFIX=v1
LOG_LEVEL=debug

# ─── Database ───
DATABASE_URL=postgresql://tihe:tihe_dev_password@localhost:5432/tihe?schema=public

# ─── Redis (BullMQ + rate limiting) ───
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatible: RustFS in Compose, any provider in prod) ───
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tihe_minio
S3_SECRET_KEY=tihe_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RAW=tihe-raw
S3_BUCKET_VOD=tihe-vod
# Presigned URLs are signed for the host the client will use. If clients reach storage through
# nginx, this must be the public hostname, not the internal one, or every signature fails.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGN_TTL_SECONDS=120

# ─── Crypto (from generate-secrets.sh — NEVER commit real values) ───
KEK_BASE64=
LICENSE_PRIVATE_KEY_BASE64=
LICENSE_PUBLIC_KEY_BASE64=
JWT_SECRET=
PASSWORD_PEPPER=
# Shared with services/live (its API_INTERNAL_TOKEN).
INTERNAL_API_TOKEN=

# ─── Tokens ───
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── Sign-in ───
# Failed attempts allowed in the window, per phone number and per address.
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_PHONE=10
LOGIN_MAX_FAILURES_PER_IP=50

# ─── Protection defaults (courses can override) ───
# Devices signed in at once until an admin sets the default in the app.
DEFAULT_MAX_DEVICES=2
DEFAULT_MAX_CONCURRENT_STREAMS=1
DEFAULT_OFFLINE_WINDOW_DAYS=30
PLAYBACK_SESSION_TTL_SECONDS=7200
PLAYBACK_HEARTBEAT_SECONDS=30

# ─── LiveKit webhook verification ───
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_production_00000000
# Set true ONLY in development: accepts unsigned webhooks so fake-egress.sh works.
LIVEKIT_WEBHOOK_ALLOW_UNSIGNED=true

# ─── Media pipeline ───
RAW_RETENTION_DAYS=7
